# Скопировать в .env и заполнить. В чат токен не присылать.
# Этот файл НЕ попадает в репозиторий (см. .gitignore).

# Токен бота из BotFather. Обязателен для режима Telegram-бота.
BOT_TOKEN=

# URL цели для парсинга (если бот используется как парсер). Оставьте пустым для только-бота.
TARGET_URL=

# Интервал проверки в секундах.
CHECK_INTERVAL=60

# Имя файла экспорта.
EXPORT_FILE=export.json

# Формат экспорта: json или csv.
EXPORT_FORMAT=json

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO